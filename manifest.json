{
  "manifest_version": 3,
  "name": "Lightweight Tab Suspender",
  "version": "1.0",
  "description": "Suspends inactive tabs to save memory, with search and whitelisting. sapkDJG IOSDBHNOJ",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["search/search.html", "suspended/suspended.html"],
      "matches": ["<all_urls>"]
    }
  ]
}